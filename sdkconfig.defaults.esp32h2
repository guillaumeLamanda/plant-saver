# ESP32-H2 (Thread + BLE) target-specific overrides.
# Applied AFTER sdkconfig.defaults; values here override the base.

# --- Task stacks (closer to ESP-IDF H2 defaults, reclaims ~10 KiB) ---
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048

# --- BLE (Bluedroid) for Matter commissioning ---
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_A2DP_ENABLE=n
# BLE 4.2 only — NB: CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n disables only
# the *host* 5.0 extensions; the H2 controller needs CONFIG_BT_LE_50_FEATURE_SUPPORT=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_LE_50_FEATURE_SUPPORT=n
# BTC uses ~1.1 KiB at startup; 4 KiB retains ~3 KiB headroom.
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
# Single ACL connection (commissioning only needs one)
CONFIG_BT_ACL_CONNECTIONS=1
# Minimal bonding
CONFIG_BT_SMP_MAX_BONDS=3
# Static BLE env memory — avoids heap fragmentation on memory-constrained H2
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
# --- BLE controller pool trims for 112 KiB H2 (defaults are for 512 KiB+ chips) ---
CONFIG_BT_LE_ACL_BUF_COUNT=4
CONFIG_BT_LE_HCI_EVT_HI_BUF_COUNT=8
CONFIG_BT_LE_HCI_EVT_LO_BUF_COUNT=4
CONFIG_BT_LE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_LE_MSYS_2_BLOCK_COUNT=12
# GATT client stays on — esp-idf-svc requires gattc headers at compile time

# --- WiFi/BLE coexistence (H2 needs Thread/BLE coex) ---
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- IEEE 802.15.4 / OpenThread — MTD instead of FTD ---
CONFIG_IEEE802154_ENABLED=y
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_THREAD_NETWORK=y
# Minimal Thread Device (not Full Thread Device) — saves ~8 KiB+ of buffers
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_FTD=n
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=65
CONFIG_OPENTHREAD_MLE_MAX_CHILDREN=4
CONFIG_OPENTHREAD_TMF_ADDR_CACHE_ENTRIES=8
CONFIG_OPENTHREAD_SRP_CLIENT_MAX_SERVICES=2
