{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "~/.cargo/registry/*": "allow",
      "~/.cargo/git/*": "allow",
    },
  },
  "lsp": true,
  "agent": {
    "general": {
      "model": "vercel/deepseek/deepseek-v4-pro",
    },
    "plan": {
      "model": "vercel/deepseek/deepseek-v4-pro",
    },
    "explore": {
      "model": "vercel/deepseek/deepseek-v4-flash",
    },
    "build": {
      "model": "vercel/deepseek/deepseek-v4-pro",
    },
  },
}
