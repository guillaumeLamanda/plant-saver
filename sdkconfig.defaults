# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# Main loop only does ADC read + LED set + log — 4K is plenty and reclaims 4K heap for BLE
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Stack sizes the Matter stack depends on (too low by default)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# FreeRTOS tick at 1000 Hz for 1ms sleep granularity
CONFIG_FREERTOS_HZ=1000

# 4MB flash (ESP32 DevKit V1 default)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom partition table: 3MB factory app (Matter + WiFi + BLE needs >1MB)
# Path is relative to the esp-idf-sys OUT_DIR (6 levels up to project root)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"

# BLE (Bluedroid) for Matter commissioning — BLE-only mode, no Classic BT
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BTC_TASK_STACK_SIZE=15000
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# WiFi/BLE coexistence
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- Heap reclamation for WROOM-32 (no PSRAM) ---
# Matter commissioning needs ~270B contiguous; without these trims the
# largest free block drops below that and BLE malloc fails.
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_ESP_WIFI_TX_BA_WIN=2
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2048
# WiFi static RX buffers: 10→4 reclaims ~9.6 KiB (each is 1600B, pre-allocated)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
# WiFi dynamic buffers: 32→16 reduces heap ceiling during commissioning
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# WiFi mgmt short buffers: 32→16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# So that the QR code does not get distorted by misaligned log lines
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n
