# Build target: ESP32-C6
CONFIG_IDF_TARGET="esp32c6"

# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# Main loop only does ADC read + LED set + log — 4K is plenty and reclaims 4K heap for BLE
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Stack sizes the Matter stack depends on (too low by default)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# FreeRTOS tick at 1000 Hz for 1ms sleep granularity
CONFIG_FREERTOS_HZ=1000

# 8MB flash (ESP32-C6 DevKit)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Flash mode for ESP32-C6 (QIO 80 MHz)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ESP32-C6 modem: enable WiFi component (required by esp-idf-matter wireless module gate)
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STA_ENABLED=y

# Bluetooth (Bluedroid BLE) for Matter commissioning
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_CONTROLLER_ONLY=n

# OpenThread for Matter operational network (ESP32-C6 has 802.15.4 radio)
CONFIG_OPENTHREAD_ENABLED=y

# So that the QR code does not get distorted by misaligned log lines
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n
